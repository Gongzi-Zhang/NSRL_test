#!/bin/bash

script=$(realpath -- ${BASH_SOURCE[0]})
ROOT=$(dirname $script)/..
source ${ROOT}/setup.sh
source ${ROOT}/lib/zdc.sh

while [ $# -gt 0 ]
do
    run=$1
    if ! `${ROOT}/bin/zdcDB query --run $run --field Type >> /dev/null`; then
	logger fatal "not a valid run: $run" >&2
	shift
	continue
    fi
    runType=$(${ROOT}/bin/zdcDB -p query --run $run --field Type | xargs)
    listFile=$(getFile "Run${run}_list.txt")
    figDir=${ROOT}/figures/${run}
    if ! [ -d $figDir ]; then
	mkdir $figDir
    fi

    if [ "$runType" = "ptrg" ]; then
	rootFile="${ROOT}/data/Run${run}_hist.root"
	pedFile="${ROOT}/data/Run${run}_ped.json"
	if ! [ -f "$rootFile" ]; then
	    ${ROOT}/bin/make_hist -i $listFile -o $rootFile -m "ptrg"
	fi
        ${ROOT}/bin/fit_ptrg -i $rootFile -o $pedFile
        ${ROOT}/bin/plot_ptrg -i $pedFile -o ${figDir}
    elif [ "$runType" = "mip" ]; then
	rootFile="${ROOT}/data1/Run${run}_hist.root"
	mipFile="${ROOT}/data1/Run${run}_mip.json"
	pedRun=$(${ROOT}/bin/zdcDB -p query --run $run --field PedRun | xargs)
	pedFile=$(getFile "Run${pedRun}_ped.json")
	# if ! [ -f "$rootFile" ]; then
	    ${ROOT}/bin/make_hist -i $listFile -o $rootFile -p $pedFile -m "mip"
	# fi
        ${ROOT}/bin/fit_mip -i $rootFile -o $mipFile
        ${ROOT}/bin/plot_mip -i $mipFile -o $figDir -p $pedFile
    elif [ "$runType" = "data" ] || [ "$runType" = "cmdata" ]; then
	rootFile="${ROOT}/data/Run${run}.root"
	if ! [ -f "$rootFile" ]; then
	    ${ROOT}/bin/zdc convert $run
	    ${ROOT}/bin/zdc calibrate $run
	fi
        # ${ROOT}/bin/zdc calibrate $run
        # ${ROOT}/bin/zdc QA $run
    fi
    if [ $? -ne 0 ]; then
	${ROOT}/bin/zdcDB update --run $run --field Flag --value bad
    else
	scp -qr ${ROOT}/figures/${run}/ weibin@gpu:public/NSRL_test/figures/
    fi

    shift
done
